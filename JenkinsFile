pipeline {
    agent any
    parameters {
        string(defaultValue:'', description:"TAGS", name: "API_TAGS")
        choices(choices: ['POST', 'GET', 'PUT', 'DELETE'], description: 'Select Tag', name: 'API_METHOD')
    }
    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup & Install Dependencies') {
            steps {
                sh '''
                    pwd
                    ls -l
                    python3 -m venv venv
                    venv/bin/python -m pip install --upgrade pip
                    venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    venv/bin/robot -i ${API_TAGS} -d results tests/api_json_film_tests.robot
                '''
            }
        }
    }
    post {

        always {

            // Publish Robot Framework Results (Plugin)
            robot(
                outputPath: 'results',
                outputFileName: 'output.xml',
                reportFileName: 'report.html',
                logFileName: 'log.html',
                passThreshold: 100,
                unstableThreshold: 90
            )
        }
       }
}
