pipeline{
        
    agent any

        stages{
            stage("Clean Up"){
            steps{
                deleteDir()
            }
            }
            stage("Build"){
                steps{
                    sh "pip3 install -r requirements.txt"
                }
            }
            stage("Test"){
                steps{
                    sh "robot --outputdir reports  tests/api_json_film_tests.robot"
                }
            }
        }


}
