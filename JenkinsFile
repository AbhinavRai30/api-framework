pipeline {
    agent any
    parameters {
   
        choice(choices: ['POST', 'GET', 'PUT', 'DELETE', 'CLEANUP', 'JSON'], description: 'Select Tag', name: 'API_METHOD')
    }
    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup & Install Dependencies') {
            steps {
                sh '''
                    pwd
                    ls -l
                    python3 -m venv venv
                    venv/bin/python -m pip install --upgrade pip
                    venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    venv/bin/robot --include ${API_METHOD} --outputdir results tests/api_json_film_tests.robot
                '''
            }
        }
    }
    post {

        always {

            // Publish Robot Framework Results (Plugin)
            robot(
                outputPath: 'results',
                outputFileName: 'output.xml',
                reportFileName: 'report.html',
                logFileName: 'log.html',
                passThreshold: 100,
                unstableThreshold: 90
            )
            
            // Send Email Notification with Results
            emailext(
                subject: "Robot Framework Test Results - Build #${BUILD_NUMBER} - ${currentBuild.result}",
                body: """
                    Latest Robot Results:
                    \tTotal\tFailed\tPassed\tSkipped\tPass %
                    All tests\t${ROBOT_TOTAL}\t${ROBOT_FAILED}\t${ROBOT_PASSED}\t0\t${ROBOT_PASSPERCENTAGE}
                    
                    Build URL: ${BUILD_URL}
                    
                    Please check the attached reports for detailed test results.
                """,
                attachmentsPattern: 'results/*.html, results/*.xml',
                to: 'abhinav.rai6@gmail.com',
                mimeType: 'text/html'
            )
        }
       }
}
