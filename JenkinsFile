pipeline{
        
    agent any

        stages{
            stage("Clean Up"){
            steps{
                deleteDir()
            }
            }
            stage("Build"){
                steps{
                    sh "python -m venv venv"
                    sh "venv/Scripts/Activate"
                    sh "./venv/bin/pip install -r requirements.txt"
                }
            }
            stage("Test"){
                steps{
                    sh "robot --outputdir reports  tests/api_json_film_tests.robot"
                }
            }
        }


}
