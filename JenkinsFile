pipeline{
        
    agent any

        stages{
            stage("Clean Up"){
                steps{
                    deleteDir()
            ````     }
            }
            stage('Setup and Run') {
                steps {
                    sh '''
                    # 1. Create the venv if it doesn't exist
                    python3 -m venv venv
                    
                    # 2. Activate the venv
                    . venv/bin/activate
                    
                    # 3. Install dependencies and run scripts
                    pip install -r requirements.txt
                    python3 main.py
                '''
                }
            }
            stage("Test"){
                steps{
                    sh "robot --outputdir reports  tests/api_json_film_tests.robot"
                }
            }
        }


}
