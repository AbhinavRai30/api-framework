pipeline {
    agent any

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup & Install Dependencies') {
            steps {
                sh '''
                    pwd
                    ls -l
                    python3 -m venv venv
                    venv/bin/python -m pip install --upgrade pip
                    venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    venv/bin/robot --outputdir reports  tests/api_json_film_tests.robot
                '''
            }
        }
    }
    post {

        always {

            // Publish Robot Framework Results (Plugin)
            robot(
                outputPath: 'results',
                outputFileName: 'output.xml',
                reportFileName: 'report.html',
                logFileName: 'log.html',
                passThreshold: 100,
                unstableThreshold: 90
            )

            script {
                try {
                    emailext(
                        subject: "Robot Test Results - ${currentBuild.currentResult}",
                        body: """
                        <h3>Robot Framework Test Results</h3>
                        <p><b>Job:</b> ${env.JOB_NAME}</p>
                        <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                        <p><b>Status:</b> ${currentBuild.currentResult}</p>
                        <p>
                        <a href="${env.BUILD_URL}robot/report">Robot Report</a><br/>
                        <a href="${env.BUILD_URL}robot/log">Robot Log</a>
                        </p>
                        """,
                        to: "abhinav.rai6@gmail.com",
                        attachmentsPattern: "reports/report.html, reports/log.html",
                        mimeType: 'text/html'
                    )
                } catch (err) {
                    echo "Email sending failed but build will continue: ${err}"
                }
            }
    }   }
}
